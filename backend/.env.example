# --- Server ---
PORT=3001
# Comma-separated origins allowed to call this API.
# Add your Lovable preview URL, published URL, and any custom domain.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://ai-spark-engine-11.lovable.app

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=origami99

# --- Auth ---
# Use a long random string. Rotating invalidates all admin sessions.
JWT_SECRET=please-change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=12h

# --- SMTP (any provider: Gmail app password, Zoho, Mailgun, SendGrid, etc.) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Origami99 Leads <no-reply@origami99.com>"

# Where lead notifications are sent.
LEAD_NOTIFY_TO=engage@origami99.com
